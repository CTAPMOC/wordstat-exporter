PORT=8788
YANDEX_API_KEY=YOUR_YANDEX_API_KEY
YANDEX_FOLDER_ID=YOUR_YANDEX_FOLDER_ID
# Generated by npm run password. Never put a plain password here.
AUTH_PASSWORD_HASH=
# Use true when serving behind HTTPS. Local HTTP requires false.
COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8788,http://localhost:8788
